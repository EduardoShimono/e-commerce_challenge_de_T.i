<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${tituloPagina}"/> | Arena Games</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="${ctx}/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-arena sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="${ctx}/">
            <i class="bi bi-controller"></i> Arena<span class="text-arena">Games</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <form class="d-flex mx-lg-auto my-2 my-lg-0 busca-topo" action="${ctx}/loja" method="get" role="search">
                <input class="form-control form-control-sm" type="search" name="busca"
                       placeholder="Buscar jogos, consoles, acessórios..." value="${fn:escapeXml(param.busca)}">
                <button class="btn btn-sm btn-arena ms-1" type="submit"><i class="bi bi-search"></i></button>
            </form>

            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item">
                    <a class="nav-link" href="${ctx}/carrinho">
                        <i class="bi bi-cart3"></i> Carrinho
                        <c:if test="${sessionScope.carrinho.totalItens > 0}">
                            <span class="badge rounded-pill bg-arena-accent">${sessionScope.carrinho.totalItens}</span>
                        </c:if>
                    </a>
                </li>

                <c:choose>
                    <c:when test="${not empty sessionScope.usuarioLogado}">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i> <c:out value="${sessionScope.usuarioLogado.nome}"/>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="${ctx}/meus-pedidos">Meus pedidos</a></li>
                                <c:if test="${sessionScope.usuarioLogado.admin}">
                                    <li><a class="dropdown-item" href="${ctx}/admin/produtos">Painel administrativo</a></li>
                                </c:if>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form action="${ctx}/logout" method="post" class="px-3">
                                        <button type="submit" class="btn btn-link p-0 text-danger text-decoration-none">Sair</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </c:when>
                    <c:otherwise>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/login">Entrar</a></li>
                        <li class="nav-item"><a class="btn btn-sm btn-outline-light ms-lg-2" href="${ctx}/cadastro">Criar conta</a></li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </div>
    </div>
</nav>

<main class="flex-grow-1 py-4">
<div class="container">

<c:if test="${not empty sessionScope.mensagem}">
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <c:out value="${sessionScope.mensagem}"/>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
    <c:remove var="mensagem" scope="session"/>
</c:if>
<c:if test="${not empty sessionScope.erro}">
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <c:out value="${sessionScope.erro}"/>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
    <c:remove var="erro" scope="session"/>
</c:if>
